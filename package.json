{
  "name": "search-tabs-for-zammad",
  "version": "1.0.2",
  "private": true,
  "description": "Automatic search tabs for Zammad",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/extension.test.cjs tests/private.test.cjs tests/search-builder.test.cjs tests/build.test.cjs",
    "test:firefox": "node --test tests/firefox.test.cjs",
    "demo": "node scripts/demo.cjs",
    "check:release": "node scripts/check-release.cjs",
    "build": "node scripts/build.cjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "package:chrome": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Browser chrome",
    "package:firefox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Browser firefox",
    "store:assets": "node scripts/store-assets.cjs",
    "privacy:sync": "node scripts/sync-privacy.cjs",
    "prepare:github": "node scripts/prepare-github.cjs"
  },
  "author": "Eugene Bachura",
  "license": "MIT",
  "devDependencies": {
    "playwright": "1.57.0"
  }
}
